# ==========================================================
# Vir Engineers — Production Environment Variables Template
# ==========================================================

# Node Server Configuration
NODE_ENV=production
PORT=5000

# Allowed Frontend URL for Strict CORS
FRONTEND_URL=https://virpackaging.com

# ----------------------------------------------------------
# SUPABASE CONFIGURATION (SERVER-SIDE ONLY)
# ----------------------------------------------------------
# Server-side connection using the private service role key.
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY MUST NEVER BE EXPOSED TO THE FRONTEND
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ----------------------------------------------------------
# SUPABASE CONFIGURATION (CLIENT-SIDE / VITE)
# ----------------------------------------------------------
# Public client connection used by frontend Supabase client for auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key

# ----------------------------------------------------------
# RESEND EMAIL SERVICE CONFIGURATION (SERVER-SIDE ONLY)
# ----------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
TO_EMAIL=sales@virpackaging.com
FROM_EMAIL=Vir Engineers <onboarding@resend.dev>
